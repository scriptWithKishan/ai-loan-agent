# Neon Serverless PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require

# Retell AI (https://beta.retellai.com/)
RETELL_API_KEY=key_xxxxxxxxxxxxxxxx
RETELL_AGENT_ID=agent_xxxxxxxxxxxx

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxx

# Admin Security Passcode for Dashboard
ADMIN_PASSCODE=admin123456

# Base Application URL (Required for Retell Webhook Callbacks)
# Local: http://localhost:3000 (or use ngrok/localtunnel for local webhook testing)
# Production: https://your-app.vercel.app
APP_URL=http://localhost:3000

# Default Business Settings
COMPANY_NAME="Sunrise Capital"
DEFAULT_LANGUAGE="English"
